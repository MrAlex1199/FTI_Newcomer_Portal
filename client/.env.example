# ================================
# FTI Welcome Hub - Client Environment Variables
# ================================
# Copy this file to .env and update values as needed
# NEVER commit .env file to git!

# ================================
# API CONFIGURATION
# ================================
# Backend API URL (include /api/v1 path)
# Development: http://localhost:5000/api/v1
# Production: https://your-backend.onrender.com/api/v1 (or your backend domain)
VITE_API_URL=http://localhost:5000/api/v1

# ================================
# FEATURE FLAGS (Optional)
# ================================
# Uncomment to enable/disable features
# VITE_ENABLE_ANALYTICS=false
# VITE_ENABLE_DEBUG=false

# ================================
# EXTERNAL SERVICES (Optional)
# ================================
# Google Maps API (if using custom maps)
# VITE_GOOGLE_MAPS_API_KEY=your_api_key

# ================================
# QUICK START
# ================================
# 1. Copy this file: cp .env.example .env
# 2. Update VITE_API_URL to match your backend
# 3. Start development: npm run dev
# 4. For production: Update API URL to production backend domain
