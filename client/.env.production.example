# ================================
# FTI Welcome Hub - Client Production Environment
# ================================
# Use this for production deployment
# Set these as environment variables in your deployment platform (Vercel/Netlify)

# ================================
# API CONFIGURATION
# ================================
# Backend API URL - MUST include /api/v1 path
# Replace with your actual production backend domain
VITE_API_URL=https://your-backend-domain.onrender.com/api/v1

# Examples for different platforms:
# Render: https://fti-welcome-hub.onrender.com/api/v1
# Railway: https://fti-welcome-hub.up.railway.app/api/v1
# Heroku: https://fti-welcome-hub.herokuapp.com/api/v1
# AWS: https://api.fti-welcome-hub.com/api/v1

# ================================
# DEPLOYMENT PLATFORM SETUP
# ================================

# For Vercel:
# 1. Go to Project Settings → Environment Variables
# 2. Add VITE_API_URL with production backend URL
# 3. Redeploy

# For Netlify:
# 1. Go to Site Settings → Build & Deploy → Environment
# 2. Add VITE_API_URL with production backend URL
# 3. Trigger redeploy

# ================================
# IMPORTANT NOTES
# ================================
# - VITE_ prefix is required for Vite to expose variables to client
# - Backend URL must be HTTPS in production
# - Backend must have CORS configured for your frontend domain
# - Test the API URL is accessible before deployment
