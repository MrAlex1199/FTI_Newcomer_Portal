# ================================
# FTI Welcome Hub - Server Environment Variables
# ================================
# Copy this file to .env and replace placeholder values
# NEVER commit .env file to git!

# ================================
# APPLICATION CONFIGURATION
# ================================
NODE_ENV=development
PORT=5000

# Frontend URL (must match exact client URL)
# Development: http://localhost:5173
# Production: https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# ================================
# DATABASE CONFIGURATION
# ================================
# Development (Local MongoDB):
# MONGO_URI=mongodb://127.0.0.1:27017/fti_welcome_hub

# Development/Production (MongoDB Atlas):
# Get connection string from: https://cloud.mongodb.com
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/fti_welcome_hub?retryWrites=true&w=majority

# ================================
# JWT SECURITY
# ================================
# CRITICAL: Generate secure secrets for production!
# Generate using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# NEVER use these example values in production!

JWT_SECRET=your_secure_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=15m

REFRESH_TOKEN_SECRET=your_secure_refresh_token_secret_here_must_be_different
REFRESH_TOKEN_EXPIRES_IN=7d

# ================================
# COOKIE CONFIGURATION
# ================================
# Set COOKIE_SECURE=true in production (requires HTTPS)
# COOKIE_SECURE=false
# COOKIE_SAME_SITE=strict

# ================================
# CLOUDINARY CONFIGURATION
# ================================
# Image upload and storage service
# Get credentials from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ================================
# FILE UPLOAD CONFIGURATION
# ================================
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# ================================
# RATE LIMITING (Optional)
# ================================
# Uncomment to customize rate limits
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
# AUTH_RATE_LIMIT_MAX_REQUESTS=5

# ================================
# LOGGING (Optional)
# ================================
# LOG_LEVEL=info

# ================================
# QUICK START
# ================================
# 1. Copy this file: cp .env.example .env
# 2. Set up MongoDB Atlas (see docs/MONGODB_SETUP.md)
# 3. Set up Cloudinary account
# 4. Replace all placeholder values
# 5. For production: Generate new JWT secrets (see docs/PRODUCTION_SECRETS_SETUP.md)
