# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/fti_welcome_hub

# JWT Configuration
JWT_SECRET=your_secure_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your_secure_refresh_token_secret_here
REFRESH_TOKEN_EXPIRES_IN=7d

# Cloudinary Configuration (Optional for Task 1)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
