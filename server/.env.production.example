# Production Environment Variables
# Copy this file to .env and replace all placeholder values with actual production values

# ================================
# APPLICATION CONFIGURATION
# ================================
NODE_ENV=production
PORT=5000

# Frontend URL (replace with your actual Vercel/Netlify domain)
CLIENT_URL=https://your-app.vercel.app

# ================================
# DATABASE CONFIGURATION
# ================================
# MongoDB Atlas production cluster connection string
# Create cluster at https://cloud.mongodb.com
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>
MONGO_URI=mongodb+srv://prod_user:YOUR_PASSWORD_HERE@cluster0.xxxxx.mongodb.net/fti_welcome_hub?retryWrites=true&w=majority

# ================================
# JWT SECURITY (GENERATE NEW SECRETS!)
# ================================
# Generate secure secrets using:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# NEVER use development secrets in production!
# NEVER commit actual secrets to git!

JWT_SECRET=REPLACE_WITH_64_CHAR_SECRET_FROM_CRYPTO
JWT_EXPIRES_IN=15m

REFRESH_TOKEN_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_SECRET
REFRESH_TOKEN_EXPIRES_IN=7d

# ================================
# COOKIE CONFIGURATION
# ================================
# Set to true when using HTTPS (required for production)
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict

# ================================
# CLOUDINARY CONFIGURATION
# ================================
# Create production account at https://cloudinary.com
# Get credentials from: Dashboard > Account Details
CLOUDINARY_CLOUD_NAME=your_production_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ================================
# FILE UPLOAD CONFIGURATION
# ================================
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# ================================
# RATE LIMITING
# ================================
# Requests per window (adjust based on expected traffic)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Auth-specific rate limiting (stricter)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# ================================
# LOGGING (Optional)
# ================================
# Set log level: error, warn, info, debug
LOG_LEVEL=info

# ================================
# EMAIL CONFIGURATION (Future)
# ================================
# Uncomment when email functionality is implemented
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-app-password
# EMAIL_FROM=noreply@functioninter.co.th

# ================================
# MONITORING (Optional but Recommended)
# ================================
# Sentry for error tracking
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# ================================
# SECURITY NOTES
# ================================
# 1. NEVER commit this file with real values to git
# 2. Store secrets in deployment platform's environment variables
# 3. Rotate secrets regularly (every 90 days recommended)
# 4. Use different secrets for development, staging, and production
# 5. Enable 2FA on all cloud service accounts
